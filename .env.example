# Ejemplo para desarrollo local: API en el Mac y MySQL en Docker.
# Copia este archivo a .env antes de arrancar la aplicación.
# Contraseñas de ejemplo para la prueba local.

# La imagen oficial de MySQL usa estas variables al inicializar un volumen vacío.
MYSQL_ROOT_PASSWORD=root_prueba
MYSQL_DATABASE=task_manager
MYSQL_USER=app
MYSQL_PASSWORD=app

# FastAPI usa estas variables para conectar con el puerto publicado en el Mac.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# Alternativa opcional: una URL completa tiene prioridad sobre las variables anteriores.
# DATABASE_URL=mysql+pymysql://app:app@127.0.0.1:3307/task_manager
